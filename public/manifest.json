{
  "manifest_version": 3,
  "name": "Smart Locator Inspector",
  "short_name": "Locator Inspector",
  "version": "1.0.0",
  "description": "Hover any element to get validated, ranked Playwright and Selenium Java locators. Runs locally; no page data leaves your browser.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Smart Locator Inspector",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting"],
  "commands": {
    "toggle-inspector": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Start or stop element inspection on the current tab"
    }
  }
}
